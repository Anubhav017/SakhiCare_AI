# Copy to .env for a new setup and replace the placeholders.
DB_CONNECTION=postgresql+psycopg://postgres:replace-me@127.0.0.1:5433/sakhicare
POSTGRES_PASSWORD=replace-me
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120
EMBEDDING_MODEL=nomic-embed-text
CHAT_MODEL=llama3.2:3b

RAG_MAX_UPLOAD_BYTES=10485760
RAG_MAX_CHUNKS=250
RAG_CHUNK_SIZE=1100
RAG_CHUNK_OVERLAP=180
RAG_EMBED_BATCH_SIZE=64
RAG_PDF_TOP_K=5
RAG_PDF_MAX_DISTANCE=0.55
RAG_TASK_LIMIT=200

RAG_WORKER_POLL_SECONDS=2
RAG_WORKER_LEASE_SECONDS=300
RAG_WORKER_MAX_ATTEMPTS=3
RAG_WORKER_RETRY_SECONDS=15
AUTO_CREATE_TABLES=false
SESSION_COOKIE_SECURE=false
